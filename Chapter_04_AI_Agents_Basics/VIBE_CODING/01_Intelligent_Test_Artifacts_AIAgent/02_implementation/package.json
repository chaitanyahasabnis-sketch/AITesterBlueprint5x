{
  "name": "test-artifacts-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Jira issue -> test plan, test strategy and test cases, generated from the project templates.",
  "scripts": {
    "build": "vite build",
    "start": "node src/backend/server.js",
    "dev:backend": "node --watch src/backend/server.js",
    "dev:frontend": "vite",
    "test": "node --test src/backend/tests/ src/frontend/tests/",
    "bundle-templates": "node scripts/bundle-templates.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "docx": "^9.16.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  }
}
