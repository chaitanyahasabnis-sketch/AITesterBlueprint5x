# Copy the keys you need into Chapter_04_AI_Agents_Basics/.env (the file the backend reads).
# Never commit real values.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
GROQ_API_KEY=

# Optional
# LLM_PROVIDER=groq            # groq | ollama
# GROQ_MODEL=openai/gpt-oss-120b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=
# GROQ_TPM_LIMIT=8000          # tokens/minute of your Groq tier, used to size requests
# PORT=3001
# ENV_FILE=/absolute/path/to/.env
# TEMPLATE_DIR=/absolute/path/to/01_plan
