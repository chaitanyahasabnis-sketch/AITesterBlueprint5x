{
  "name": "vwo-login-playwright-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript POM framework for the VWO (Wingify) Login Dashboard",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:valid": "playwright test tests/login-valid.spec.ts",
    "test:invalid": "playwright test tests/login-invalid.spec.ts",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure generate allure-results --clean -o allure-report --open",
    "clean": "node -e \"for (const d of ['allure-results','allure-report','playwright-report','test-results']) require('fs').rmSync(d,{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "allure": "^3.22.1",
    "allure-js-commons": "^3.14.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  }
}
