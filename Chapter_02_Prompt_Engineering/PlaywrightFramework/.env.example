# Copy this file to .env and fill in values. Never commit .env.

# Application under test
BASE_URL=https://app.wingify.com/#/login

# Verified test account (leave empty if you do not have one).
# When empty, the successful-login scenarios are SKIPPED, never faked.
VALID_EMAIL=
VALID_PASSWORD=

# Execution
HEADLESS=true
WORKERS=2
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
EXPECT_TIMEOUT_MS=10000
